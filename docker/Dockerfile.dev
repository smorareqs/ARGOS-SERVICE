# Dockerfile de desarrollo: toolchain completo de Go y hot-reload con air.
# docker-compose monta el codigo en /app, asi que cada cambio recompila.

FROM golang:1.27

RUN go install github.com/air-verse/air@v1.67.4

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

EXPOSE 8000

CMD ["air", "-c", ".air.toml"]
